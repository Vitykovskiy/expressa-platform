{
  "name": "expressa-e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "e2e": "node tools/run-e2e-sequential.mjs",
    "e2e:boundaries": "node tools/check-e2e-boundaries.mjs",
    "e2e:desktop": "playwright test --project=chromium",
    "e2e:headed": "node tools/run-e2e-sequential.mjs --headed",
    "e2e:mobile": "playwright test --project=mobile-chromium",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write --ignore-path .prettierignore --ignore-path .gitignore --no-error-on-unmatched-pattern \"{components,pages,fixtures,specs,support,tools,docs}/**/*.{ts,md}\" \"*.{ts,json,md}\"",
    "format:check": "prettier --check --ignore-path .prettierignore --ignore-path .gitignore --no-error-on-unmatched-pattern \"{components,pages,fixtures,specs,support,tools,docs}/**/*.{ts,md}\" \"*.{ts,json,md}\"",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.0"
  }
}
