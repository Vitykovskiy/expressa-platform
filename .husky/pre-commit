#!/bin/sh

set -eu

repository_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  printf '%s\n' 'pre-commit: unable to locate Git repository.' >&2
  exit 1
}
cd "$repository_root"

lint-staged

if ! git diff --cached --check; then
  printf '%s\n' 'pre-commit: staged diff contains whitespace errors.' >&2
  exit 1
fi

has_sensitive_filename=0
while IFS= read -r staged_file; do
  case "$staged_file" in
    *.pem|*.key|*.p12|*.pfx|*/id_rsa|id_rsa|*/id_dsa|id_dsa|*/id_ecdsa|id_ecdsa|*/id_ed25519|id_ed25519|*/credentials|credentials|*/credentials.json|credentials.json|*/secrets.*|secrets.*|*.secret|*.secrets)
      has_sensitive_filename=1
      ;;
    */.env|.env|*/.env.*|.env.*)
      case "$staged_file" in
        *.env.example|*.env.sample|*.env.template) ;;
        *) has_sensitive_filename=1 ;;
      esac
      ;;
  esac
done <<EOF
$(git diff --cached --name-only --diff-filter=ACMR)
EOF

if [ "$has_sensitive_filename" -eq 1 ]; then
  printf '%s\n' 'pre-commit: staged file name appears to contain secret material.' >&2
  exit 1
fi

has_sensitive_content=0
queue_page_fixture='+  useSessionStore: () => ({ accessToken: "'
queue_page_fixture="${queue_page_fixture}access-token\" }),"
orders_constants_fixture='+export const ordersAccessTokenSecret = "'
orders_constants_fixture="${orders_constants_fixture}orders-e2e-access-token-secret\";"
orders_e2e_fixture='+const accessToken = "'
orders_e2e_fixture="${orders_e2e_fixture}e2e-dummy-access-token\";"
order_lifecycle_fixture="+      AUTH_ACCESS_TOKEN_SECRET: '"
order_lifecycle_fixture="${order_lifecycle_fixture}order-lifecycle-access-token-secret',"

while IFS= read -r staged_file; do
  added_lines=$(git diff --cached --no-ext-diff --unified=0 -- "$staged_file" \
    | grep '^+' \
    | grep -Ev '^\+\+\+') || true

  case "$staged_file" in
    back-office/src/pages/QueuePage.spec.ts)
      added_lines=$(printf '%s\n' "$added_lines" \
        | grep -Fvx "$queue_page_fixture") || true
      ;;
    back-office/tests/e2e/orders.e2e.constants.ts)
      added_lines=$(printf '%s\n' "$added_lines" \
        | grep -Fvx "$orders_constants_fixture") || true
      ;;
    back-office/tests/e2e/orders.e2e.ts)
      added_lines=$(printf '%s\n' "$added_lines" \
        | grep -Fvx "$orders_e2e_fixture") || true
      ;;
    backend/test/integration/order-lifecycle.integration.spec.ts)
      added_lines=$(printf '%s\n' "$added_lines" \
        | grep -Fvx "$order_lifecycle_fixture") || true
      ;;
  esac

  case "$staged_file" in
    *.ts|*.tsx|*.js|*.mjs|*.cjs|*.vue)
      added_lines=$(printf '%s\n' "$added_lines" \
        | grep -Eiv '(api[_-]?key|password|passwd|secret|token|database[_-]?url)[[:space:]]*[:=][[:space:]]*[A-Za-z_$][A-Za-z0-9_$.]*[[:space:]]*[,;)}]') || true
      ;;
  esac

  if printf '%s\n' "$added_lines" \
    | grep -Ei '(BEGIN([[:space:]][A-Z]+)*[[:space:]]PRIVATE[[:space:]]KEY|AKIA[0-9A-Z]{16}|github_pat_[A-Za-z0-9_=-]{16,}|gh[pousr]_[A-Za-z0-9_=-]{16,}|glpat-[A-Za-z0-9_-]{16,}|xox[baprs]-[A-Za-z0-9-]{16,}|authorization[[:space:]]*:[[:space:]]*bearer[[:space:]]+[A-Za-z0-9._=-]{16,}|(api[_-]?key|password|passwd|secret|token|database[_-]?url)[[:space:]]*[:=][[:space:]]*[^[:space:]#]{12,})' \
    | grep -Eiv '(\$\{[^}]+\}|process\.env|import\.meta\.env|<[^>]+>|example|sample|template|placeholder|changeme|your[_-]?(api|token|secret|password|key)|postgres(ql)?://[^[:space:]#]*(localhost|127\.0\.0\.1|::1))' >/dev/null; then
    has_sensitive_content=1
    break
  fi
done <<EOF
$(git diff --cached --name-only --diff-filter=ACMR)
EOF

if [ "$has_sensitive_content" -eq 1 ]; then
  printf '%s\n' 'pre-commit: staged content appears to contain secret material.' >&2
  exit 1
fi
