{
  "name": "expressa-back-office",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --config ../.prettierrc.json --write .",
    "format:check": "prettier --config ../.prettierrc.json --check .",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry"
  },
  "dependencies": {
    "@mdi/js": "7.4.47",
    "pinia": "3.0.4",
    "vue": "3.5.43",
    "vuetify": "3.13.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@storybook/vue3-vite": "10.6.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.9",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "prettier": "3.9.6",
    "storybook": "10.6.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vue-tsc": "3.3.12"
  }
}
