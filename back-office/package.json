{
  "name": "expressa-back-office",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "build": "npm run typecheck && vite build",
    "lint": "eslint .",
    "typecheck": "vue-tsc --build",
    "test": "vitest",
    "storybook": "storybook dev --port 6006",
    "storybook:build": "storybook build --output-dir node_modules/.storybook-static",
    "test:storybook": "vitest run --config .storybook/vitest.config.ts",
    "test:a11y": "PLAYWRIGHT_TARGET=storybook playwright test --project=storybook-a11y",
    "test:visual": "PLAYWRIGHT_TARGET=storybook playwright test --project=storybook-visual",
    "test:e2e": "VITE_APP_ENV=development VITE_API_BASE_URL=http://127.0.0.1:3000 npm run build && PLAYWRIGHT_TARGET=app playwright test --project=app-e2e && PLAYWRIGHT_TARGET=storybook playwright test --project=storybook-e2e",
    "contract:check": "node scripts/check-openapi.mjs"
  },
  "dependencies": {
    "pinia": "3.0.4",
    "vue": "3.5.40",
    "vue-router": "4.5.1",
    "vuetify": "4.1.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/browser-playwright": "4.1.10",
    "@vue/test-utils": "2.4.11",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.5",
    "@storybook/addon-vitest": "10.5.5",
    "@storybook/vue3-vite": "10.5.5",
    "eslint": "10.8.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.8.0",
    "jsdom": "30.0.1",
    "playwright": "1.62.1",
    "storybook": "10.5.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9"
  }
}
