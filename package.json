{
  "name": "expressa-tooling",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "prettier": "3.9.6"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,vue,css,html,json,md,yml,yaml}": "prettier --write --ignore-unknown"
  }
}
