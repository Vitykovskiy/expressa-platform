{
  "name": "expressa-front-office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{vue,ts,css}\" \".storybook/**/*.{ts,vue,mjs,json}\" \"tests/**/*.{ts,vue,mjs}\" \"*.{js,mjs,cjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{vue,ts,css}\" \".storybook/**/*.{ts,vue,mjs,json}\" \"tests/**/*.{ts,vue,mjs}\" \"*.{js,mjs,cjs,json}\"",
    "typecheck": "vue-tsc --build",
    "test": "vitest",
    "storybook": "STORYBOOK=true storybook dev -p 6006",
    "storybook:build": "STORYBOOK=true storybook build -o /tmp/expressa-front-office-storybook && node .storybook/scripts/check-manifest.mjs",
    "test:a11y": "PLAYWRIGHT_TARGET=a11y playwright test",
    "test:visual": "PLAYWRIGHT_TARGET=visual playwright test",
    "test:e2e": "PLAYWRIGHT_TARGET=app playwright test",
    "contract:check": "node scripts/check-openapi.mjs"
  },
  "dependencies": {
    "lucide-vue-next": "1.0.0",
    "pinia": "3.0.4",
    "vue": "3.5.40",
    "vue-router": "4.5.1",
    "vuetify": "4.1.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.5",
    "@storybook/addon-docs": "10.5.5",
    "@storybook/vue3-vite": "10.5.5",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.8.0",
    "http-server": "14.1.1",
    "jsdom": "30.0.1",
    "pg": "8.16.3",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "sass": "1.93.2",
    "storybook": "10.5.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9"
  }
}
